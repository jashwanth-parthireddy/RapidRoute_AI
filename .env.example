# ─────────────────────────────────────────────
#  RapidRoute AI — Environment Variables
# ─────────────────────────────────────────────

# --- Application ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://rapidroute:rapidroute123@localhost:5432/rapidroute_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rapidroute_db
DB_USER=rapidroute
DB_PASSWORD=rapidroute123

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
# Generate with: [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=Ms675NwCk3uvuWoak6E5nBVnNnONVn75H+MqPoB+FOWadrAkIgqkLQX0VT5sirCkoc88BJYa+9l96KDdgdYAEg==
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=zsHRQSfayQxFsFziTNqpTdvTmRlyFABXOmNM/8TkdUhtGfkNAr185qnIlfyR9oy4n/4JmQLz2xJDp6/bJ6bZlw==
JWT_REFRESH_EXPIRES_IN=7d

# --- AI Service ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=10000

# --- Map Provider ---
# Options: 'osm' (free, default) | 'mapbox' | 'google'
MAP_PROVIDER=osm
MAPBOX_TOKEN=
GOOGLE_MAPS_KEY=

# --- Email (Nodemailer) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@rapidroute-ai.com

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Logging ---
LOG_LEVEL=info

# --- AI Service (Python) ---
AI_HOST=0.0.0.0
AI_PORT=8000
